# Hubio 2026 Enterprise Environment Configuration Matrix

# Server Port & Mode
PORT=5000
NODE_ENV=production

# Database (PostgreSQL 16)
POSTGRES_USER=hubio_admin
POSTGRES_PASSWORD=hubio_secret_2026
POSTGRES_DB=hubio_enterprise
DATABASE_URL=postgresql://hubio_admin:hubio_secret_2026@localhost:5432/hubio_enterprise?schema=public

# In-Memory Cache (Redis 7)
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=hubio_jwt_enterprise_key_2026_super_secure_random_hash
JWT_EXPIRES_IN=7d

# Push Notifications (Expo Push API)
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# Object Storage (AWS S3 / Cloudflare R2 for Contracts and Videos)
S3_ENDPOINT=https://storage.hubio.digital
S3_BUCKET_NAME=hubio-vault-assets
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
